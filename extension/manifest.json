{
  "manifest_version": 3,
  "name": "Octo Probe",
  "version": "3.2.2",
  "description": "Runs login and registration workflows on the E-VISA site inside an Octo Browser profile.",

  "permissions": ["storage", "activeTab", "scripting", "tabs", "downloads", "alarms", "debugger"],
  "host_permissions": ["<all_urls>"],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": [
        "http://localhost/*/worker-init*",
        "http://127.0.0.1/*/worker-init*",
        "http://*/*worker-init*",
        "https://*/*worker-init*"
      ],
      "js": ["hub-init.js"],
      "run_at": "document_end"
    },
    {
      "matches": ["*://pedidodevistos.mne.gov.pt/*"],
      "js": ["antidetect.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "Octo Probe",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
