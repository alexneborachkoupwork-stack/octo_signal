{
  "name": "octo-manager",
  "version": "1.0.0",
  "description": "Octo Browser profile orchestrator — manages sessions and communicates with extension workers",
  "main": "index.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env index.js",
