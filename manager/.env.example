# Octo Browser local API — start/stop (no path suffix, 127.0.0.1 required)
OCTO_API_URL=http://127.0.0.1:58888
# Octo Browser API key (Settings → Additional tab in Octo Browser)
OCTO_API_KEY=
# Cloud API URL — override only if using a custom Octo instance
# OCTO_CLOUD_URL=https://app.octobrowser.net/api/v2/automation


# Hub WebSocket + HTTP port
HUB_PORT=9000

# Session limits
MAX_RETRIES=2
BROWSER_START_TIMEOUT_MS=30000
EXT_CONNECT_TIMEOUT_MS=60000

# Default consular post ID
CONSUL_POST=5084
